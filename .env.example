# Public identifiers, not passwords. Replace all placeholders.
PUBLIC_ORIGIN=https://research.example.com
ACCESS_ISSUER=https://your-team.cloudflareaccess.com
ACCESS_AUDIENCE=REPLACE_WITH_64_HEX_APPLICATION_AUD
# Resolve reviewed image versions to their sha256 digest before launch.
PYTHON_IMAGE=python:3.13-slim@sha256:REPLACE_WITH_REVIEWED_DIGEST
CLOUDFLARED_IMAGE=cloudflare/cloudflared@sha256:REPLACE_WITH_REVIEWED_DIGEST
# Only used when running directly, outside Docker:
HOSTED_ROOT=/absolute/private/path/hosted-data
